{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "lib": ["ES2020", "DOM"],
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "rootDir": "./demo",
    "outDir": "./demo/dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["demo/**/*.ts"],
  "exclude": ["node_modules", "dist", "demo/dist", "**/*.md", "demo/index-old.ts", "demo/message_queue.ts", "demo/outbound-integration.ts", "demo/server.ts", "demo/simple_server.ts"]
}
